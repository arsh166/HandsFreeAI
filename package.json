{
  "name": "handsfreedai",
  "version": "0.1.0",
  "description": "Fully hands-free AI assistant for blind and physically disabled users",
  "main": "src/ui/electron-main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:desktop": "electron-builder",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.js"
  },
  "keywords": ["accessibility", "voice", "blind", "hands-free", "ai", "speech-recognition"],
  "author": "HandsFreeAI Team",
  "license": "MIT",
  "dependencies": {
    "electron": "^28.0.0",
    "nodemailer": "^6.9.0",
    "googleapis": "^128.0.0"
  },
  "devDependencies": {
    "vite": "^5.0.0",
    "jest": "^29.0.0",
    "eslint": "^8.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.handsfreedai.app",
    "productName": "HandsFreeAI",
    "directories": { "output": "dist" },
    "win": { "target": "nsis" },
    "mac": { "target": "dmg" },
    "linux": { "target": "AppImage" }
  },
  "jest": {
    "testEnvironment": "jsdom",
    "testMatch": ["**/tests/**/*.test.js"]
  }
}
